{
  "name": "mcp-kaggle-tool",
  "version": "0.1.0",
  "description": "MCP server for Kaggle API integration - create, run, and manage Kaggle notebooks programmatically",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-kaggle-tool": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "node --test src/**/*.test.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp-tool",
    "kaggle",
    "mcp",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0"
  },
  "overrides": {
    "js-yaml": "^4.3.0",
    "qs": "^6.14.1",
    "path-to-regexp": "^8.3.0",
    "body-parser": "^1.20.4",
    "flatted": "^3.4.2",
    "picomatch": "^4.0.5",
    "minimatch": "^10.2.5",
    "ajv": "^6.14.0",
    "@babel/core": "^7.26.0",
    "express": {
      "body-parser": "^1.20.4",
      "path-to-regexp": "^8.3.0",
      "qs": "^6.14.1"
    }
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
